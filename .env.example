# .env holds SECRETS and the agent backend. Sources (Telegram bots, GitHub
# repos) are declared in open-claw.config.yaml and reference secrets from here
# as ${VAR}. See open-claw.config.example.yaml.

# ── Secrets referenced by open-claw.config.yaml ──────────────────────
# Create a bot with @BotFather and paste the token here; reference it in the
# config as botToken: ${TELEGRAM_BOT_TOKEN}.
TELEGRAM_BOT_TOKEN=

# ── Agent backend ────────────────────────────────────────────────────
# Which model powers the agent: "deepseek", "ollama", "gemini" or "claude".
AGENT_PROVIDER=deepseek

# DeepSeek cloud API (used when AGENT_PROVIDER=deepseek). OpenAI-compatible.
# Key from https://platform.deepseek.com. Models: deepseek-chat, deepseek-reasoner.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama backend (used when AGENT_PROVIDER=ollama). Runs a local model — no API
# key and no per-second rate limits. Pull the model first: `ollama pull qwen3:8b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini backend (used when AGENT_PROVIDER=gemini). Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Claude backend (used when AGENT_PROVIDER=claude). Leave empty to use your
# Claude Code login instead of an API key.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-8

# Default working directory for Telegram tasks (a source may override it with
# workspaceRoot). File operations outside this path require approval in Telegram.
AGENT_WORKSPACE_ROOT=/Users/mypc/projects

# Max agent turns per task before it is force-stopped (cost guard).
AGENT_MAX_TURNS=40

# ── Storage ──────────────────────────────────────────────────────────
# SQLite file for task state / parsing snapshots.
DB_PATH=./data/open-claw.db

# Path to the YAML file that declares the sources.
OPEN_CLAW_CONFIG=./open-claw.config.yaml
