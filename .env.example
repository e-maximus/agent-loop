# .env holds SECRETS and agent settings. Sources (GitHub repos) are declared in
# agent-loop.config.yaml and reference secrets from here as ${VAR}.

# ── Agent backend: DeepSeek cloud API (OpenAI-compatible) ────────────────
# Key from https://platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# The implement and critic nodes run on this one instead: writing the diff and
# reviewing it are where model quality pays for itself, since weak work there
# costs the whole pipeline extra fix cycles. Reading, planning and summarising
# stay on DEEPSEEK_MODEL. Set both to the same value to run one model.
DEEPSEEK_MODEL_STRONG=deepseek-v4-pro

# Max agent steps per react-loop before it is force-stopped (cost guard).
AGENT_MAX_TURNS=100

# ── LangSmith tracing (optional) ─────────────────────────────────────────
# Traces every node, tool call and token/cost. Key from https://smith.langchain.com.
# Read once at the first traced call — setting them here works because config.py
# loads this file at import; exporting after the process starts does not.
# NOTE: traces carry tool output — repo source, shell logs, diffs — to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agent-loop

# ── Storage ──────────────────────────────────────────────────────────────
DB_PATH=./data/agent-loop.db

# Path to the YAML file that declares the sources.
AGENT_LOOP_CONFIG=./agent-loop.config.yaml

# ── Secrets for target repos (optional) ──────────────────────────────────
# agent-loop never reads these itself. A source's container.runArgs in
# agent-loop.config.yaml references them as ${VAR}, so the target repo's test
# suite finds them in its environment when the verify commands run:
#
#   container:
#     runArgs:
#       - -e
#       - CLERK_SECRET_KEY=${CLERK_SECRET_KEY}
#
# A referenced-but-unset variable fails config load, so a missing secret is a
# startup error rather than a suite that goes red halfway through. Note the
# value ends up in the `docker run` argv — visible in `ps` on this machine.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
